OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=

LLM_PROVIDER=openai
OPENAI_MODEL=gpt-6-astra
OPENAI_WIRE_API=responses
AI_REPLY_MAX_CHARS=3200
AI_REPLY_CHUNK_CHARS=750
OPENAI_TIMEOUT_MS=12000
OPENAI_IMAGE_TIMEOUT_MS=180000
AI_IMAGE_GENERATION_INTENT_THRESHOLD=0.75

PORT=5000
ONEBOT_PATH=/onebot/v11/ws
SYSTEM_PROMPT=你是QQ群内的AI助手。输出规则：禁止Markdown、LaTeX；简洁直接。
PROMPT_FILE=prompt.txt

# 可选：保留备用模型配置（当前简单模式下不会自动回退）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 触发控制
AI_REQUIRE_PREFIX=true
AI_GROUP_REQUIRE_MENTION=false
AI_PREFIXES=阿卡林
# 配置额外管理员 QQ 号，多个用英文逗号分隔
AI_ADMIN_USER_IDS=
# AI文件工具默认关闭；开启后仅此白名单账号可在独立 tool_workspace 目录操作
AI_FILE_TOOLS_ENABLE=false
# 联网搜索工具：auto 会依次使用已配置的 Tavily、博查、SearXNG、DeepSeek
# DeepSeek 搜索默认复用 DEEPSEEK_API_KEY；也可以单独填写 DEEPSEEK_SEARCH_API_KEY
AI_WEB_SEARCH_ENABLE=true
AI_WEB_SEARCH_PROVIDER=auto
AI_WEB_SEARCH_MAX_RESULTS=5
AI_WEB_SEARCH_TIMEOUT_MS=15000
AI_WEB_SEARCH_MAX_CHARS=8000
TAVILY_API_KEY=
BOCHA_API_KEY=
SEARXNG_BASE_URL=
DEEPSEEK_SEARCH_API_KEY=
DEEPSEEK_SEARCH_API_URL=https://api.deepseek.com/responses
DEEPSEEK_SEARCH_MODEL=deepseek-chat
# 安全网页正文抓取：仅允许公开 http(s)，逐跳检查重定向，拒绝内网/本机地址
AI_WEB_FETCH_ENABLE=true
AI_WEB_FETCH_TIMEOUT_MS=15000
AI_WEB_FETCH_MAX_BYTES=2097152
AI_WEB_FETCH_MAX_CHARS=12000
# 本地表情库：图片转存到受控目录，由模型按上下文决定收藏和发送
AI_STICKER_ENABLE=true
AI_STICKER_DIR=sticker_data
AI_STICKER_MAX_BYTES=10485760
AI_STICKER_MAX_COUNT=1000
AI_STICKER_MAX_COLLECT_PER_HOUR=10
# 忽略其他 WS 服务常见指令（私聊和群聊都会生效）
# 可按需增删；默认覆盖 Sakura bot 常见命令前缀
AI_IGNORE_REGEX=^(pjsk|b30|msa|msp|mysekai|tsearch|song|taikoupdate|taikorec|taikob|taikotrend|wlsk|sekai|qooapp|cnmusicupdate|cnmusicdiffupdate|sk预测|查房|分数线|段位进度|live订阅)(\\s|$)
AI_MAX_MEDIA_BYTES=10485760
AI_MEDIA_REFERER=
HTTPS_PROXY=

# 拍一拍响应
AI_POKE_ENABLE=true
AI_POKE_COOLDOWN=10
AI_POKE_REPLY_FILE=poke_replies.json
AI_CUSTOM_REPLY_FILE=custom_replies.json
AI_SCHEDULE_FILE=scheduled_tasks.json
# AI_POKE_REPLY_TEXT=[自动回复]
# AI_POKE_REPLY_TEXTS=[自动回复1]|[自动回复2]|[自动回复3]
AI_POKE_ONLY_SELF=true

# 上下文记忆
AI_CONTEXT_ENABLE=true
AI_CONTEXT_WINDOW=6
AI_CONTEXT_TTL=900
# AI对话触发时读取当前群最近几条相邻消息，作为辅助上下文
AI_GROUP_CONTEXT_MESSAGES=6
AI_GROUP_CONTEXT_MAX_CHARS=3000
AI_GROUP_CONTEXT_TTL=300
AI_RUNTIME_CACHE_MAX=1000
# AI回复队列：全局并发、单会话排队上限、总排队上限和等待超时
AI_MAX_CONCURRENT_REQUESTS=2
AI_QUEUE_MAX_PER_SESSION=10
AI_QUEUE_MAX_TOTAL=50
AI_QUEUE_WAIT_TIMEOUT_MS=120000
# 同一轮模型返回多个只读工具调用时的最大并行数
AI_TOOL_PARALLEL_MAX=4
# 单轮 agent run 的总时间预算（模型调用 + 工具执行）
AI_TURN_DEADLINE_MS=60000
# 副作用工具的互斥粒度：keyed=按资源域（默认）、global=全局串行、none=不加锁
AI_TOOL_WRITE_LOCK=keyed
# 会话级发送去重窗口；0 关闭，默认 9000ms
AI_SEND_DEDUPE_MS=9000
# 每日 token 用量统计（只记数字，不记消息内容）；单价为每百万 token，0 表示不估算成本
AI_USAGE_STATS_ENABLE=true
AI_USAGE_DIR=usage_data
AI_PRICE_INPUT_PER_1M=0
AI_PRICE_OUTPUT_PER_1M=0
# 定时任务发送失败后的重试间隔与最大尝试次数
AI_SCHEDULE_RETRY_DELAY_MS=60000
AI_SCHEDULE_MAX_ATTEMPTS=3
# 含“阿卡林”时由模型判断是在呼叫机器人还是在谈论角色
AI_NAME_INTENT_ENABLE=true
AI_NAME_INTENT_THRESHOLD=0.65
AI_NAME_INTENT_TIMEOUT_MS=10000

# 群成员长期记忆：仅作为 AI 回复的辅助材料
AI_MEMORY_ENABLE=true
AI_MEMORY_DIR=memory_data
# 原始文本日志保留天数；画像不随日志一起删除
AI_MEMORY_RETENTION_DAYS=14
# 画像缓存仅用于减少磁盘读取，受 TTL 和最大条目数双重限制
AI_MEMORY_PROFILE_CACHE_TTL=1800
AI_MEMORY_PROFILE_CACHE_MAX=500
AI_MEMORY_MESSAGE_MAX_CHARS=1000
# 每人每天送入总结模型的硬上限，控制内存和 Token
AI_MEMORY_DAILY_MAX_MESSAGES=300
AI_MEMORY_DAILY_MAX_CHARS=30000
# 每个群每日送入群级关系/别名总结的硬上限
AI_MEMORY_GROUP_DAILY_MAX_MESSAGES=500
AI_MEMORY_GROUP_DAILY_MAX_CHARS=50000
# 单次回复最多注入的画像材料字符数
AI_MEMORY_CONTEXT_MAX_CHARS=1200
# 消息事件去重缓存，同时受 TTL 和最大条目数限制
AI_MEMORY_DEDUPE_TTL=3600
AI_MEMORY_DEDUPE_MAX=5000
# 记忆总结失败后的持久化退避与熔断
AI_MEMORY_RETRY_BASE_SECONDS=3600
AI_MEMORY_MAX_RETRIES=3
# 服务器本地时区的每日总结小时，部署时应设置 TZ=Asia/Shanghai
AI_MEMORY_SUMMARY_HOUR=4

# 违禁词治理
AI_MOD_ENABLE=true
AI_BAN_DURATION=600

# 图片上下文关联策略
AI_IMAGE_CONTEXT_TTL=60
AI_IMAGE_CONTEXT_REQUIRE_HINTS=true
AI_IMAGE_HINT_REGEX=(上图|这张图|图中|这幅图|图片里|这)
AI_IMAGE_CONTEXT_REQUIRE_SAME_USER=true
AI_IMAGE_CONTEXT_MODE=ai
AI_IMAGE_CONTEXT_MAX=3
AI_IMAGE_ONLY_NO_CALL=true

# 文生图
# 需要上游兼容 OpenAI Responses 的 image_generation 工具。
# 明确生图直接触发，明确看图/分析请求直接排除，模糊表达由大模型判断并使用上方置信度阈值。
# 命中示例：阿卡林画一张在教室里微笑的动漫风图片
