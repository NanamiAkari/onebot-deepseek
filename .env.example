OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=

LLM_PROVIDER=openai
OPENAI_MODEL=gpt-5.4
OPENAI_WIRE_API=responses
AI_REPLY_MAX_CHARS=3200
AI_REPLY_CHUNK_CHARS=750
OPENAI_TIMEOUT_MS=12000
OPENAI_IMAGE_TIMEOUT_MS=180000
AI_IMAGE_GENERATION_INTENT_THRESHOLD=0.75

PORT=5000
ONEBOT_PATH=/onebot/v11/ws
SYSTEM_PROMPT=你是QQ群内的AI助手。输出规则：禁止Markdown、LaTeX；简洁直接。
PROMPT_FILE=prompt.txt

# 可选：保留备用模型配置（当前简单模式下不会自动回退）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 触发控制
AI_REQUIRE_PREFIX=true
AI_GROUP_REQUIRE_MENTION=false
AI_PREFIXES=阿卡林
# 配置额外管理员 QQ 号，多个用英文逗号分隔
AI_ADMIN_USER_IDS=
# 忽略其他 WS 服务常见指令（私聊和群聊都会生效）
# 可按需增删；默认覆盖 Sakura bot 常见命令前缀
AI_IGNORE_REGEX=^(pjsk|b30|msa|msp|mysekai|tsearch|song|taikoupdate|taikorec|taikob|taikotrend|wlsk|sekai|qooapp|cnmusicupdate|cnmusicdiffupdate|sk预测|查房|分数线|段位进度|live订阅)(\\s|$)
AI_MAX_MEDIA_BYTES=10485760
AI_MEDIA_REFERER=
HTTPS_PROXY=

# 拍一拍响应
AI_POKE_ENABLE=true
AI_POKE_COOLDOWN=10
AI_POKE_REPLY_FILE=poke_replies.json
AI_CUSTOM_REPLY_FILE=custom_replies.json
AI_SCHEDULE_FILE=scheduled_tasks.json
# AI_POKE_REPLY_TEXT=[自动回复]
# AI_POKE_REPLY_TEXTS=[自动回复1]|[自动回复2]|[自动回复3]
AI_POKE_ONLY_SELF=true

# 上下文记忆
AI_CONTEXT_ENABLE=true
AI_CONTEXT_WINDOW=6
AI_CONTEXT_TTL=900
AI_RUNTIME_CACHE_MAX=1000

# 群成员长期记忆：仅作为 AI 回复的辅助材料
AI_MEMORY_ENABLE=true
AI_MEMORY_DIR=memory_data
# 原始文本日志保留天数；画像不随日志一起删除
AI_MEMORY_RETENTION_DAYS=14
# 画像缓存仅用于减少磁盘读取，受 TTL 和最大条目数双重限制
AI_MEMORY_PROFILE_CACHE_TTL=1800
AI_MEMORY_PROFILE_CACHE_MAX=500
AI_MEMORY_MESSAGE_MAX_CHARS=1000
# 每人每天送入总结模型的硬上限，控制内存和 Token
AI_MEMORY_DAILY_MAX_MESSAGES=300
AI_MEMORY_DAILY_MAX_CHARS=30000
# 每个群每日送入群级关系/别名总结的硬上限
AI_MEMORY_GROUP_DAILY_MAX_MESSAGES=500
AI_MEMORY_GROUP_DAILY_MAX_CHARS=50000
# 单次回复最多注入的画像材料字符数
AI_MEMORY_CONTEXT_MAX_CHARS=1200
# 消息事件去重缓存，同时受 TTL 和最大条目数限制
AI_MEMORY_DEDUPE_TTL=3600
AI_MEMORY_DEDUPE_MAX=5000
# 服务器本地时区的每日总结小时，部署时应设置 TZ=Asia/Shanghai
AI_MEMORY_SUMMARY_HOUR=4

# 违禁词治理
AI_MOD_ENABLE=true
AI_BAN_DURATION=600

# 图片上下文关联策略
AI_IMAGE_CONTEXT_TTL=60
AI_IMAGE_CONTEXT_REQUIRE_HINTS=true
AI_IMAGE_HINT_REGEX=(上图|这张图|图中|这幅图|图片里|这)
AI_IMAGE_CONTEXT_REQUIRE_SAME_USER=true
AI_IMAGE_CONTEXT_MODE=ai
AI_IMAGE_CONTEXT_MAX=3
AI_IMAGE_ONLY_NO_CALL=true

# 文生图
# 需要上游兼容 OpenAI Responses 的 image_generation 工具。
# 明确生图直接触发，明确看图/分析请求直接排除，模糊表达由大模型判断并使用上方置信度阈值。
# 命中示例：阿卡林画一张在教室里微笑的动漫风图片
